# Copy to .env and fill in. Never commit .env.
# ---- Upstox (market data; orders stay deferred/live-stub) ----
UPSTOX_API_KEY=
UPSTOX_SECRET_KEY=
UPSTOX_ACCESS_TOKEN=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/callback

# ---- Telegram (optional; console fallback if absent) ----
# Create a bot via @BotFather, then message it and read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Command API (FastAPI webhook) ----
# Shared bearer token the UI / curl must send as: Authorization: Bearer <token>
COMMAND_API_TOKEN=change-me-local-token
